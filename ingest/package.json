{
  "name": "@keel/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "serve": "node --env-file-if-exists=../.env --import tsx scripts/serve.ts",
    "extract": "node --env-file-if-exists=../.env --import tsx scripts/extract.ts",
    "corpus": "node --import tsx scripts/corpus.ts",
    "corpus:run": "node --env-file-if-exists=../.env --import tsx scripts/corpus-run.ts",
    "proforma:check": "node --env-file-if-exists=../.env --import tsx scripts/proforma-check.ts",
    "llm:check": "node --env-file-if-exists=../.env --import tsx scripts/llm-check.ts",
    "demo-docs": "node --env-file-if-exists=../.env --import tsx scripts/demo-documents.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.28.0",
    "@keel/schemas": "*",
    "mailauth": "^7.3.0",
    "mailparser": "^3.9.38",
    "openai": "^7.32.0",
    "pdfjs-dist": "^6.4.299",
    "privacy-kit-cl": "0.3.0",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "fast-check": "^4.10.2",
    "pdf-lib": "^1.17.1"
