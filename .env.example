# Copy to .env (never commit it). Key custody and rotation: issue #15 (T2.7).
# The owner key is NOT here on purpose: the owner signs from their own wallet.

# Chain (Base Sepolia, chainId 84532)
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=

# Deployer, used only by contracts/script
DEPLOYER_PRIVATE_KEY=

# Agent relayer: pays gas and calls PDRGate, cannot move funds without a valid PDR
RELAYER_PRIVATE_KEY=

# Policy signer: signs PolicyDecision (EIP-712)
POLICY_SIGNER_PRIVATE_KEY=

# Automatic cosigner used by the monitor: veto, pause, revoke only
COSIGNER_PRIVATE_KEY=

# Telegram bot: sends template messages, signs nothing
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Quarantined LLM extractor
LLM_API_KEY=
