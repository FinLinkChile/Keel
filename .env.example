# Copy to .env (never commit it). Key custody and rotation: docs/arquitectura/custodia-de-llaves.md (T2.7).
# Relayer, policy signer and cosigner keys must differ: the engine refuses to load the policy key otherwise.
# The owner key is NOT here on purpose: the owner signs from their own wallet.

# Chain (Base Sepolia, chainId 84532)
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=

# Deployer, used only by contracts/script
DEPLOYER_PRIVATE_KEY=

# Agent relayer: pays gas and calls PDRGate, cannot move funds without a valid PDR
RELAYER_PRIVATE_KEY=

# Policy signer: signs PolicyDecision (EIP-712)
POLICY_SIGNER_PRIVATE_KEY=

# Automatic cosigner used by the monitor: veto, pause, revoke only
COSIGNER_PRIVATE_KEY=

# Telegram bot: sends template messages, signs nothing
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Quarantined LLM extractor: initial settings (an admin can change them at runtime)
# Provider: anthropic (default) | openai | gemini | openai-compatible
LLM_PROVIDER=anthropic
# Model id; defaults to claude-opus-5-5 for anthropic, required for the others
LLM_MODEL=
# Key for LLM_PROVIDER. Never sent or shown by the admin API.
LLM_API_KEY=
# Base URL of the provider in LLM_PROVIDER. Required for openai-compatible (Qwen via Alibaba
# DashScope, DeepSeek, Kimi, self-hosted); optional for anthropic, a proxy that speaks the
# Anthropic API (e.g. LiteLLM). https only. Environment only: the admin API cannot change it,
# because documents and the API key travel to it.
LLM_BASE_URL=
# One key per provider: the admin can only switch to providers that have one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_COMPAT_API_KEY=
# One base URL per provider, like the keys, for the providers the admin may switch to
ANTHROPIC_BASE_URL=
LLM_COMPAT_BASE_URL=

# Inbound email webhook (ingest). The forwarder sends Authorization: Bearer <token>.
# At least 32 characters, e.g. `openssl rand -hex 32`. Without it the server does not start.
INGEST_WEBHOOK_TOKEN=
# Keel Personal: JSON array of {"alias","rut","emailDomain"} registered at onboarding
INGEST_ALIASES_FILE=
INGEST_HOST=127.0.0.1
INGEST_PORT=8788
# SQLite file for deduplication, rate limits and change requests (kept out of git)
INGEST_DB_FILE=ingest.db
# Admin API (/admin/settings). Must differ from the webhook token. Unset = no admin API.
INGEST_ADMIN_TOKEN=
# Where admin changes persist across restarts (written with mode 600)
INGEST_SETTINGS_FILE=
# Initial DMARC policy. Anything but "false" requires DMARC pass.
INGEST_REQUIRE_DMARC=true
# Keel Trade uploads (POST /trade/documents). JSON array of
# {"orderId","payoutAddress","carrier","uploaders":[{"address","party"}],"knownDestinations"?}.
# Without it the route does not exist. INGEST_CHAIN_ID goes in the upload signature domain.
INGEST_ORDERS_FILE=
INGEST_CHAIN_ID=
# Optional. The app's exact origin (e.g. https://app.example): only /trade/documents answers CORS for it.
INGEST_APP_ORIGIN=
# Optional. The bot's base URL (https, or http to localhost). Ingest posts every outcome to
# {BOT_URL}/ingest/outcomes with BOT_INGEST_TOKEN (defined in the bot section), never waiting for it.
BOT_URL=

# Deployment: addresses of existing on-chain infrastructure (see contracts/script/DeployPDRGate.s.sol)
SAFE_ADDRESS=
ROLES_ADDRESS=
POLICY_SIGNER_ADDRESS=
COSIGNER_ADDRESS=
# Bytes32 hash of the active policy rules file; version the rules before setting this
POLICY_HASH=
# Optional: keccak256("AGENTE") by default; set only if you rename the agent role
# AGENT_ROLE_KEY=
