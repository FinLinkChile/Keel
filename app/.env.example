# Copy to app/.env (ignored by git). Expo inlines EXPO_PUBLIC_* variables at build time:
# they are public, so never put a key or a secret here.

# Base URL of ingest. On a phone use the computer's LAN address, not localhost.
EXPO_PUBLIC_INGEST_URL=http://192.168.1.20:8788
# Base URL of the Keel API on AWS (aws/, API Gateway). Set: proposals, orders, what needs you, the
# wallet and document uploads go through it, every request signed by the wallet of the role in use.
# Empty: proposals stay on this phone and documents go straight to ingest (EXPO_PUBLIC_INGEST_URL).
# Example: https://abc123.execute-api.us-east-1.amazonaws.com (no stage suffix such as /prod: the API
# uses the $default stage, and with a prefix every signature fails).
EXPO_PUBLIC_API_URL=
# Same value as INGEST_CHAIN_ID of ingest, or uploads are rejected as not_a_party
EXPO_PUBLIC_CHAIN_ID=
# TradeEscrow address of the closed network. Without it orders are not signed.
EXPO_PUBLIC_ESCROW_ADDRESS=

# Off by default: the app starts empty and shows only what this phone does. Set to 1 to show the
# example orders, balances and pending items of src/data/mock.ts (the ones the demo-data files
# for the bot and the agent are made from).
EXPO_PUBLIC_DEMO_SEED=

# Test builds (a release build has no developer menu): 1 shows "Wallet check" on Connect, where the
# full address of the test wallet can be copied for ingest's registry, and "Sign up again" in the
# profile. Leave it empty in anything that is not a test build.
EXPO_PUBLIC_WALLET_CHECK=

# The importer's Safe of the closed network. It is the importer of every order. Without it the
# importer cannot sign. The importer test key must be one of its owners.
EXPO_PUBLIC_IMPORTER_SAFE=
