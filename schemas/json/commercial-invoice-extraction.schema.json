{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,20}$"
    },
    "order_number": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,20}$"
    },
    "amount_minor": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "CNY",
        "HKD"
      ]
    },
    "incoterm": {
      "type": "string",
      "enum": [
        "EXW",
        "FOB",
        "CIF",
        "CFR"
      ]
    },
    "importer_tax_id": {
      "type": "string",
      "pattern": "^[0-9]{7,8}[0-9K]$"
    },
    "hs_code": {
      "type": "string",
      "pattern": "^[0-9]{6,10}$"
    },
    "mentions_account_change": {
      "type": "boolean"
    },
    "hidden_text_detected": {
      "type": "boolean"
    }
  },
  "required": [
    "invoice_number",
    "order_number",
    "amount_minor",
    "currency",
    "incoterm",
    "importer_tax_id",
    "hs_code",
    "mentions_account_change",
    "hidden_text_detected"
  ],
  "additionalProperties": false,
  "title": "CommercialInvoiceExtraction",
  "description": "Commercial invoice read by the quarantined extractor. No free text: enums, numbers and regex-validated fields only."
}
