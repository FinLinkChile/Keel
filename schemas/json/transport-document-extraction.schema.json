{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "doc_type": {
      "type": "string",
      "enum": [
        "BILL_OF_LADING",
        "AIR_WAYBILL"
      ]
    },
    "document_number": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6,20}$"
    },
    "on_board_date": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "port_of_loading": {
      "type": "string",
      "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
    },
    "port_of_discharge": {
      "type": "string",
      "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
    },
    "hidden_text_detected": {
      "type": "boolean"
    }
  },
  "required": [
    "doc_type",
    "document_number",
    "on_board_date",
    "port_of_loading",
    "port_of_discharge",
    "hidden_text_detected"
  ],
  "additionalProperties": false,
  "title": "TransportDocumentExtraction",
  "description": "Bill of lading or air waybill read by the quarantined extractor. No free text: enums, numbers and regex-validated fields only."
}
