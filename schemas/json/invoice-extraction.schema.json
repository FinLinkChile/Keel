{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FinLinkChile/Keel/schemas/json/invoice-extraction.schema.json",
  "title": "InvoiceExtraction",
  "description": "Output of the quarantined extractor. No free text: enums, numbers and regex-validated fields only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alias_id",
    "issuer_tax_id",
    "invoice_number",
    "period",
    "amount_clp",
    "due_date",
    "mentions_account_change",
    "hidden_text_detected"
  ],
  "properties": {
    "alias_id": { "enum": ["ARRIENDO", "LUZ", "INTERNET", "GASTOS_COMUNES"] },
    "issuer_tax_id": { "type": "string", "pattern": "^[0-9]{7,8}[0-9K]$" },
    "invoice_number": { "type": "string", "pattern": "^[0-9]{1,12}$" },
    "period": { "type": "string", "pattern": "^20[0-9]{2}(0[1-9]|1[0-2])$" },
    "amount_clp": { "type": "integer", "exclusiveMinimum": 0 },
    "due_date": { "type": "integer", "exclusiveMinimum": 0 },
    "mentions_account_change": { "type": "boolean" },
    "hidden_text_detected": { "type": "boolean" }
  }
}
